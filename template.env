# Template-Version: 1.0
# Template-Updated: 2026-10-11
# Template-Source: attack-workbench-frontend/template.env
#
# Changelog
# ---------
# - 1.0 (2026-10-11): Introduce template metadata

# Optional frontend settings. Copy to .env and uncomment the values you need.
# Native commands load .env automatically; existing process variables take priority.
# See docs/admin/configuration.md. All public application settings reach the browser.

# Public application settings (production website/log defaults differ; see below).
# WORKBENCH_FRONTEND_API_URL=api
# WORKBENCH_FRONTEND_ATTACK_WEBSITE_ENABLED=false
# Development default: http://localhost:8000; production: https://attack.mitre.org
# WORKBENCH_FRONTEND_ATTACK_WEBSITE_URL=https://attack.mitre.org
# WORKBENCH_FRONTEND_COLLECTION_MANAGER_ENABLED=true
# WORKBENCH_FRONTEND_RECOMMENDED_INDEXES='[{"name":"MITRE ATT&CK","url":"https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/index.json"}]'
# Use [] to remove recommended indexes.
# Development default: INFO; production: ERROR
# WORKBENCH_FRONTEND_LOG_LEVEL=INFO
# WORKBENCH_FRONTEND_DEFAULT_LANDING_PAGE=

# Optional public JSON input. Native default: src/assets/config.json; container: /etc/workbench/config.json.
# WORKBENCH_FRONTEND_CONFIG_FILE=/path/to/config.json

# Development proxy upstream origin, without an /api suffix.
# WORKBENCH_FRONTEND_API_PROXY_TARGET=http://127.0.0.1:3000

# Build metadata: package version, Git HEAD, and current UTC time by default.
# Production runtime settings do not change this bundled build identity.
# WORKBENCH_FRONTEND_APP_VERSION=3.2.0
# WORKBENCH_FRONTEND_GIT_COMMIT=abc123
# WORKBENCH_FRONTEND_BUILD_DATE=2026-10-10T12:00:00Z
# Also export generated build metadata (path relative to the command's cwd).
# WORKBENCH_FRONTEND_BUILD_INFO_OUTPUT_PATH=dist/build-info.json

# Optional real-server test endpoint (Node tests have no Angular proxy).
# WORKBENCH_FRONTEND_TEST_API_URL=http://localhost:3000/api
